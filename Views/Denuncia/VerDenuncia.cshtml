@model DenunciaModel

<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.4.4/jquery.min.js" type="text/javascript"></script>

<link rel="stylesheet" href="~/css/Formulario.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Denuncia.css" asp-append-version="true" />

<h3 class="mb-4">
    <i class="fa-solid fa-bookmark me-2" style="color:lightgreen"></i>
    Denúncia #@Model.id
</h3>

<div class="main-content container ">
    <partial name="_Postagem" />

    <form asp-action="Comentar" method="post" enctype="multipart/form-data" class="text-lg-start mb-4">

        <input type="hidden" asp-for="id" />
       
        <span asp-validation-for="mensagem"
              class="text-danger small"></span>

        <label asp-for="mensagem" class="form-label">
            <i class="fa-solid fa-comment me-2"></i>Comentários
        </label>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
            <textarea asp-for="mensagem"
                      required
                      id="txtInput"
                      rows="2"
                      contenteditable
                      class="form-control dark-input"
                      style="margin-right:1%"
                      placeholder="Escreva um comentário">
              </textarea>

            <button type="submit" class="btn btn-primary rounded-pill">
                <i class="fa-solid fa-upload"></i>
            </button>

        </div>
    </form>

    @if (Model.comentarios != null)
    {
        @foreach (ComentarioModel comentario in Model.comentarios)
        {
            <div data-id="@Model.id" class="card denuncia-card shadow-lg mb-4 card-body">
               @comentario.mensagem
            </div>
        }
    }
    else
    {
        <div class="align-content-center">Não há comentários</div>
    }

</div>

<script>
    $("#txtInput").autogrow();
</script>