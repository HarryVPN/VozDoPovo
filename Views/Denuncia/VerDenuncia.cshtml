@model DenunciaModel

<link rel="stylesheet" href="~/css/Denuncia.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Formulario.css" asp-append-version="true" />

<h3 class="mb-4">
    <i class="fa-solid fa-bookmark me-2" style="color:lightgreen"></i>
    Denúncia #@Model.id
</h3>

<div class="main-content container ">
    <partial name="_Postagem" />

    <form asp-action="Comentar" method="post" enctype="multipart/form-data" class="text-lg-start mb-4">

        <input type="hidden" asp-for="id"/>

       
        <span asp-validation-for="mensagem"
              class="text-danger small"></span>

        <label asp-for="mensagem" class="form-label">
            <i class="fa-solid fa-comment me-2"></i>Comentários
        </label>

        <textarea asp-for="mensagem"
                  required
                  rows="2"
                  id="contexto"
                  class="form-control dark-input"
                  placeholder="Explique seu problema">
              </textarea>


        <button type="submit"
                class="btn btn-primary rounded-pill px-4">

            <i class="fa-solid fa-floppy-disk me-2"></i>
            Adicionar
        </button>

    </form>

    @if (Model.comentarios != null)
    {
        @foreach (ComentarioModel comentario in Model.comentarios)
        {
            <div>@comentario.mensagem</div>
        }
    }
</div>