@model DenunciaModel
@{
    ViewData["Title"] = "Editar Denuncia";
}

<head>
    <h1>Edite sua Denuncia</h1>
    <small class="form-text text-muted">Descreva bem a situação</small>
</head>

<form asp-action="DenunciaEditada" method="post" enctype="multipart/form-data" class="text-lg-start">
    <input type="hidden" asp-for="id" />
    <partial name="_Shared/Formulario" />

    <a role="button" class="btn btn-danger" asp-controller="Denuncia" asp-action="DeletarDenuncia" asp-route-id="@Model.id">Deletar</a>
</form>