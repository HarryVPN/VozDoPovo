@model DenunciaModel

<h3 class="mb-4">
    <i class="fa-solid fa-triangle-exclamation me-2" style="color:orange"></i>
    Editar Denúncia #@Model.id
</h3>

<form asp-action="EditarDenuncia" method="post" enctype="multipart/form-data" class="text-lg-start">
    
    <input type="hidden" asp-for="id" />
    <input type="hidden" asp-for="data" />

    <partial name="_Formulario"/>
</form>