@Html.AntiForgeryToken()
@model DenunciaModel
@{
    ViewData["Title"] = "Mapa Interativo";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<style>
    #map {
        height: 500px;
        width: 100%;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .map-coordinates {
        margin-top: 12px;
    }
</style>

<link rel="stylesheet" href="~/css/Formulario.css" asp-append-version="true" />

<div class="container py-4 card denuncia-form border-0 shadow-lg  card-body p-4 p-lg-5">
     
    <div class="mb-3">

        <label asp-for="contexto" class="form-label">
            Denúncia
        </label>

        <textarea asp-for="contexto"
                  required
                  rows="8"
                  id="contexto"
                  class="form-control dark-input mb-4"
                  placeholder="Explique seu problema">
              </textarea>

        <span asp-validation-for="contexto" class="text-danger small"></span>

        <div class="d-flex align-items-center border-bottom border-top pb-1 pt-1" style="float:left">
            
            <input asp-for="anonimo" type="checkbox" name="anonimo" style="transform: scale(1.5); position: relative; top: -2px"/>

            <label asp-for="anonimo" class="px-2">Anônimo</label>
        </div>

    </div>


    <div class="mb-3">

        <label for="imagemInput" class="form-label">
            Imagem (opcional)
        </label>

        <input asp-for="arquivoImg"
               type="file"
               accept="image/*"
               id="imagemInput"
               class="form-control dark-input" />

        <div class="form-text text-secondary mt-2">
            JPG, PNG ou WEBP
        </div>

        <input type="hidden"
               name="imagem"
               value="@Model.imagem">

    </div>

    <div class="preview-container mb-4">

        @if (Model.imagem != null)
        {
            <img id="preview"
                 src="~/images/@Model.imagem"
                 class="preview-image"
                 alt="Pré-visualização da imagem" />
        }
        else
        {
            <img id="preview"
                 class="preview-image d-none"
                 alt="Pré-visualização da imagem" />
        }

    </div>

    <div class="container mt-4">
        <h2>Selecionar localização</h2>

        @if (TempData["Mensagem"] != null)
        {
            <div class="alert alert-success">
                @TempData["Mensagem"]
            </div>
        }

        <p>
            Clique no mapa para selecionar uma localização.
            Você também pode arrastar o marcador.
        </p>
            <div id="map"></div>

            <div class="row map-coordinates">
                <div class="col-md-6 mb-3">
                    <label asp-for="latitude" class="form-label">
                        Latitude
                    </label>

                    <input asp-for="latitude"
                           id="Latitude"
                           class="form-control"
                           readonly
                           step="any"/>

                    <span asp-validation-for="latitude"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="longitude" class="form-label">
                        Longitude
                    </label>

                    <input asp-for="longitude"
                           id="Longitude"
                           class="form-control"
                           readonly
                           step="any" />

                    <span asp-validation-for="longitude"
                          class="text-danger"></span>
                </div>
            </div>

    </div>

    <div class="d-flex justify-content-end gap-3">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-4">

            <i class="fa-solid fa-x me-1"></i>
            Cancelar
        </a>
        
        @if (ViewContext.RouteData.Values["action"]?.ToString() == "EditarDenuncia")
        {

            <a asp-controller="Denuncia"
               asp-action="DeletarDenuncia"
               asp-route-id="@Model.id"
               class="btn btn-danger rounded-pill px-4">

                <i class="fa-solid fa-trash me-1"></i>
                Deletar
            </a>
        }
        
        <button type="submit"
                class="btn btn-primary rounded-pill px-4">

            <i class="fa-solid fa-floppy-disk me-2"></i>
            Salvar
        </button>

    </div>

</div>





<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    const initialLatitude = Number(document.getElementById("Latitude").textContent)
    const initialLongitude = Number(document.getElementById("Longitude").textContent)

    // Create the map.
    const map = L.map('map').setView(
        [initialLatitude, initialLongitude],
        13
    );

    // Load OpenStreetMap tiles.
    L.tileLayer(
        'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            maxZoom: 19,
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">' +
                'OpenStreetMap</a> contributors'
        }
    ).addTo(map);

    const latitudeInput = document.getElementById('Latitude');
    const longitudeInput = document.getElementById('Longitude');

    // Create a draggable marker.
    const marker = L.marker(
        [initialLatitude, initialLongitude],
        { draggable: true }
    ).addTo(map);

    marker.bindPopup('Localização selecionada').openPopup();

    // Update the form fields.
    function updateCoordinates(latitude, longitude) {
        latitudeInput.value = latitude.toFixed(6);
        longitudeInput.value = longitude.toFixed(6);
    }

    // Initialize the fields.
    updateCoordinates(initialLatitude, initialLongitude);

    // Clicking the map moves the marker.
    map.on('click', function(event) {
        marker.setLatLng(event.latlng);

        updateCoordinates(
            event.latlng.lat,
            event.latlng.lng
        );

        marker.openPopup();
    });

    // Dragging the marker updates the coordinates.
    marker.on('dragend', function(event) {
        const position = event.target.getLatLng();

        updateCoordinates(
            position.lat,
            position.lng
        );
    });
</script>
