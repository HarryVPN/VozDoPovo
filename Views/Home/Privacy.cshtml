@{
    Layout = "_Layout";
}
@*
<head>
	<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
</head> *@
<body class="row">

    <div class="card shadow">
        <a>Entrada da Guarita</a>

        <button id="btnLimpar">Limpar</button>
        <button id="btnPlaca">Placa</button>


        <div class="form-group">
            <label id="placaUi" for="nome">Nome</label>
            <input type="text" class="form-control" aria-describedby="nomeHelp" placeholder="ABC1D23">
        </div>

        <a id="plates">Ppppp</a>

        <img src="http://10.1.94.2:5000/video_feed">

    </div>
</body>

<script>
    const btnLimpar = document.getElementById('btnLimpar')
    const placaUi = document.getElementById('placaUi')

    const url = "http://10.1.94.2:5000"

    btnLimpar.addEventListener('click',async () => {

        document.getElementById('plates').textContent = Date.now();

        fetch(url+"/reset", {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        });
    })

    const btnPlaca = document.getElementById('btnPlaca')

    btnPlaca.addEventListener('click', async () => {

        placaUi.textContent = Date.now();

        try {

            const response = await fetch(url + "/get_placa");

            if (!response.ok) {
                throw new Error(`Response status: ${response.status}`);
            }

            const json = await response.json();

            console.log(json);

            placaUi.textContent = json.placa;

        } catch (error) {
            console.error(error.message);
        }
    });

</script>