@using VozDoPovo.Data
@using System.Text.Json
@model List<DenunciaModel>

<link rel="stylesheet" href="~/css/Denuncia.css" asp-append-version="true" />

@{
    bool lixeira = ViewContext.RouteData.Values["action"]?.ToString() == "Lixeira";
    // ComentarioModel teste = ViewBag.teste;
}

@* Leitura de placas *@
@* <div id="print"></div>

<div class="card-body position-relative p-0 d-flex align-items-center justify-content-center">
    <!-- Área da câmera -->
    <div class="camera-frame">
        <video id="cameraVideo" autoplay playsinline></video>

        <canvas id="overlayCanvas"></canvas>

        <canvas id="cameraCanvas" style="display:none;"></canvas>
    </div>
</div>

<button id="enviar" class="btn btn-sm">Enviar</button>
<script src="~/js/CameraPlaca.js" asp-append-version="true"></script> *@

@* <img src="~/bennesby-animado.gif" width="332" height="264" /> *@

<div class="main-content">
    @* <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"> *@
    @* <div role="alert" class="alert alert-success">
        <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
        Bem vindo ao site!
    </div> *@

    @if (TempData[MeusIDs.Sucesso] != null)
    {
        JsonDenuncia? denuncia = JsonSerializer.Deserialize<JsonDenuncia?>(TempData[MeusIDs.Sucesso].ToString());
        if (denuncia != null)
        {
            <div role="alert" class="alert alert-success">
                <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
                Denuncia #@denuncia.id adicionada!
            </div>
        }
    }

    <div class="container py-4">

        @if (Model != null && Model.Any())
        {
            @foreach (var denuncia in Model.OrderByDescending(x => x.id))
            {
                <partial name="_Postagem" model=denuncia />
            }
        }
    </div>

</div>
