@using VozDoPovo.Data
@using System.Text.Json
@model List<DenunciaModel>

<style>
    /* Área principal com rolagem interna apenas se necessário */
    .main-content {
        flex-grow: 1;
        padding: 20px 40px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    h2 {
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 24px;
    }

    .containerScanner {
        display: flex;
        gap: 20px;
        max-width: 1200px; /* Limita a largura para não espalhar demais */
        margin-bottom: 4%;
    }

    .box {
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #334155;
        flex: 1;
    }

    .box-preview {
        width: 300px; /* Reduzi um pouco a largura da lateral */
        flex-shrink: 0;
    }


    .scannerEntrada {
        text-align: center;
        border: 2px dashed var(--accent-green);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        background: rgba(255, 140, 0, 0.05);
    }

        .scannerEntrada i {
            font-size: 35px;
            color: var(--accent-green);
            margin-bottom: 10px;
            display: block;
        }

        .scannerEntrada p {
            margin: 5px 0;
            font-size: 14px;
        }


    .scannerSaida {
        text-align: center;
        border: 2px dashed var(--accent-red);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        background: rgba(255, 140, 0, 0.05);
    }

        .scannerSaida i {
            font-size: 35px;
            color: var(--accent-red);
            margin-bottom: 10px;
            display: block;
        }

        .scannerSaida p {
            margin: 5px 0;
            font-size: 14px;
        }


    .row {
        display: flex;
        gap: 15px;
        /* margin-bottom: 20px; */
    }

    .form-group {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    input, select {
        padding: 10px;
        margin-top: 5px;
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        border-radius: 6px;
        width: 100%;
        box-sizing: border-box;
        font-size: 14px;
    }

    .btn-confirm {
        background: var(--accent-green);
        color: #0f172a;
        border: none;
        padding: 15px;
        width: 100%;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
    }

    /* Ajuste da imagem para telas menores */
    .product-preview-img {
        width: 100%;
        height: 150px;
        background: #0f172a;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 10px 0;
    }

    .label-desc {
        font-size: 11px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-valor {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    body {
        background-color: #0f172a;
        color: #e2e8f0;
    }

    .denuncia-card {
        background: #1e293b;
        border-radius: 1.5rem;
        transition: all 0.25s ease;
    }

        .denuncia-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.35) !important;
        }

    .denuncia-date {
        color: #94a3b8;
        font-size: 0.95rem;
    }

    .denuncia-content {
        color: #e2e8f0;
        line-height: 1.8;
        text-align: justify;
        white-space: pre-line;
    }

    .image-wrapper {
        height: 300px;
        overflow: hidden;
        border-radius: 1rem;
        border: 1px solid #334155;
        background-color: #0f172a;
    }

    .card .border-bottom {
        border-color: #334155 !important;
    }

    .btn-outline-primary {
        border-width: 2px;
    }

        .btn-outline-primary:hover {
            transform: translateY(-1px);
        }


</style>

<h3>
    <i class="fa-solid fa-list me-2"></i>
    Denúncias Recentes
</h3>

<div class="main-content">
    @* <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"> *@
    @* <div role="alert" class="alert alert-success">
        <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
        Bem vindo ao site!
    </div> *@

    @if (TempData[MeusIDs.Sucesso] != null)
    {
        JsonDenuncia? denuncia = JsonSerializer.Deserialize<JsonDenuncia?>(TempData[MeusIDs.Sucesso].ToString());
        if (denuncia != null)
        {
            <div role="alert" class="alert alert-success">
                <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
                Denuncia #@denuncia.id adicionada!
            </div>
        }
    }

    <div class="container py-4">

        @if (Model != null && Model.Any())
        {
            @foreach (var denuncia in Model.OrderByDescending(x => x.id))
            {
                @* <partial name="_Postagem" model=denuncia /> *@
                <div data-id="@denuncia.id"
                     class="card denuncia-card border-0 shadow-lg mb-4">

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">

                            <div class="d-flex align-items-center gap-3">
                                <div class="denuncia-date">
                                    <i class="fa-solid fa-calendar-days me-2"></i>
                                    @denuncia.data
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <div class="denuncia-date">
                                    <i class="fa-solid fa-location-dot me-2"></i>
                                    Av. Jorge Teixeira
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <div class="denuncia-date">
                                    <i class="fa-solid fa-person me-2"></i>
                                    Fulano Ciclano
                                </div>
                            </div>

                            <a class="btn btn-outline-primary rounded-pill px-4"
                               asp-controller="Denuncia"
                               asp-action="EditarDenuncia"
                               asp-route-id="@denuncia.id">

                                <i class="fa-solid fa-pen-to-square me-2"></i>
                                Editar
                            </a>

                        </div>

                        <div class="row">

                            <div class="@(denuncia.imagem != null ? "col-lg-8" : "col-12")">

                                <div class="denuncia-content">
                                    @denuncia.contexto
                                </div>

                            </div>

                            @if (denuncia.imagem != null)
                            {
                                <div class="col-lg-4 pb-2">

                                    <div class="image-wrapper">
                                        <img src="~/images/@denuncia.imagem"
                                             class="img-fluid rounded-4 h-100 w-100 object-fit-cover"
                                             alt="Imagem da denúncia">
                                    </div>

                                </div>
                            }

                            @* Botões de baixo *@
                            <div class="border-bottom"></div>

                            <div class="d-flex" style="float:right">
                                
                                <div class="btn btn-primary rounded-pill">
                                    <a class="btn btn-primary"
                                       asp-controller="Denuncia"
                                       asp-action="Like"
                                       asp-route-id="@denuncia.id">

                                        <i class="fa-solid fa-thumbs-up me-2"></i>
                                        @denuncia.likes
                                    </a>

                                    <a class="btn btn-primary"
                                       asp-controller="Denuncia"
                                       asp-action="Dislike"
                                       asp-route-id="@denuncia.id">

                                        <i class="fa-solid fa-thumbs-down me-2"></i>
                                        @denuncia.dislikes
                                    </a>

                                    <a class="btn btn-primary align-content-end px-4"
                                       asp-controller="Denuncia"
                                       asp-action="VerDenuncia"
                                       asp-route-id="@denuncia.id">

                                        <i class="fa-solid fa-comment me-2"></i>
                                        0
                                    </a>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>