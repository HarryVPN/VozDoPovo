@using VozDoPovo.Data
@using System.Text.Json
@model List<DenunciaModel>

<link rel="stylesheet" href="~/css/Denuncia.css" asp-append-version="true" />

<h3>
    <i class="fa-solid fa-list me-2"></i>
    Denúncias Recentes
</h3>

<div class="main-content">
    @* <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"> *@
    @* <div role="alert" class="alert alert-success">
        <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
        Bem vindo ao site!
    </div> *@

    @if (TempData[MeusIDs.Sucesso] != null)
    {
        JsonDenuncia? denuncia = JsonSerializer.Deserialize<JsonDenuncia?>(TempData[MeusIDs.Sucesso].ToString());
        if (denuncia != null)
        {
            <div role="alert" class="alert alert-success">
                <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
                Denuncia #@denuncia.id adicionada!
            </div>
        }
    }

    <div class="container py-4">

        @if (Model != null && Model.Any())
        {
            @foreach (var denuncia in Model.OrderByDescending(x => x.id))
            {
                <partial name="_Postagem" model=denuncia />
            }
        }
    </div>

</div>