@using VozDoPovo.Data
@using System.Text.Json
@model List<DenunciaModel>
@{
    ViewData["Title"] = "Início";
}

<body class="text-center">

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">

    <div role="alert" class="alert alert-success">
        <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
        Bem vindo ao site!
    </div>


    @if (TempData[MeusIDs.Sucesso] != null)
    {
        JsonDenuncia? denuncia = JsonSerializer.Deserialize<JsonDenuncia>(TempData[MeusIDs.Sucesso].ToString());
        if (denuncia != null)
        {
            <div role="alert" class="alert alert-success">
                <button type="button" class="btn btn-danger btn-sm close-alert" arial-label="Close">X</button>
                Denuncia #@denuncia.id adicionada!
            </div>
        }
    }

    <h1>Denuncias Recentes</h1>

    <table class="table table-hover align-middle table-responsive p-3 container shadow">
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var denuncia in Model.OrderBy(x => x.id))
                {
                    <div data-id="@denuncia.id" class="card shadow border-4 rounded-4 p-2" style="margin-bottom:10px">

                        <div class="d-flex justify-content-between border-bottom border-4 pb-2 mb-2">
                            @* <span>João Pedro Cunha</span> *@
                            <span>@denuncia.data</span>

                            <i class="glyphicon glyphicon-thumbs-up"></i>
                            <a role="button" class="btn btn-primary" asp-controller="Denuncia" asp-action="EditarDenuncia" asp-route-id="@denuncia.id">Editar</a>
                        </div>
                        <div class="position-relative" style="min-height:300px;">

                            <div class="pe-5" style="margin-right:220px; text-align:justify">
                                @denuncia.contexto
                            </div>

                            @if (denuncia.imagem != null)
                            {
                                <div class="position-absolute top-0 end-0 border border-2 p-0" style="width:220px;height:300px;">
                                    <img src="~/images/@denuncia.imagem" class="img-fluid h-100 w-100 object-fit-cover">
                                </div>
                            }
                        </div>

                    </div>
                }
            }
        </tbody>
    </table>
   
</body>

                            
